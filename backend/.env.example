# ==============================================================================
# MedicReminder Backend - Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# Never commit actual secret values to source control.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (comma-separated). Set to frontend URL.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# In development (NODE_ENV !== 'production'), mongodb.js defaults to local MongoDB:
# mongodb://localhost:27017/medicreminder
# For remote MongoDB Atlas or production, supply the connection URI below:
MONGO_URI_ATLAS=mongodb://localhost:27017/medicreminder

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit random string for local development:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=24h

# ------------------------------------------------------------------------------
# 4. Microservice Endpoints
# ------------------------------------------------------------------------------
# Base URL for the Python disease prediction FastAPI microservice
DISEASE_MODEL_BASE=http://127.0.0.1:5001

# ------------------------------------------------------------------------------
# 5. External Services (ACTION REQUIRED)
# ------------------------------------------------------------------------------
# Telegram Bot API Token
# Required for Telegram notifications and reminder scheduling.
# Obtain from Telegram: https://t.me/BotFather (Send /newbot and paste token here)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
