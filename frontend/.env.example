# ==============================================================================
# MedicReminder Frontend - Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local for local development.

# API Base URL for Express backend (proxied via Vite dev server)
VITE_API_BASE_URL=/api

# Direct backend URL if running outside Vite dev proxy
VITE_BACKEND_DIRECT_URL=http://localhost:3000

# Base URL for ML / Prescription OCR Flask service
VITE_ML_BASE_URL=http://localhost:5000

# Base URL for Disease Prediction service
VITE_PREDICTION_URL=http://localhost:5001
