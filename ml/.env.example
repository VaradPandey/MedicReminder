# ==============================================================================
# MedicReminder ML / Prescription OCR Service - Environment Template (.env.example)
# ==============================================================================
# Configure Groq API for prescription parsing & extraction

# Groq API Key (Required for prescription extraction)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Groq Base URL (OpenAI-compatible endpoint)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional fallback: Local OCR engine configuration
# OCR engine priority: Windows Media OCR (built-in on Windows) -> pytesseract -> vision model
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe


