# ==============================================================================
# MedicReminder ML / Prescription OCR Service - Environment Template (.env.example)
# ==============================================================================

# Active Vision Provider: 'gemini', 'openai', or 'openrouter'
VISION_PROVIDER=gemini

# Google Gemini Configuration (Recommended Production Provider: 1-4s latency)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-flash-lite-latest

# OpenAI Configuration (Alternative Production Provider)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL_ID=gpt-4o-mini

# OpenRouter Configuration (Legacy / Fallback Provider)
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=your_openrouter_api_key_here
# VISION_MODEL_ID=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Service Port
PORT=5000

# Offline Testing / Mock Mode: Set to 'true' to return simulated prescription data
# MOCK_OCR=false
